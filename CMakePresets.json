{
  "version": 3,
  "configurePresets": [
    {
      "name": "vcpkg-x64",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "vcpkg-x64",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "configurePreset": "vcpkg-x64",
      "configuration": "Release"
    },
    {
      "name": "relwithdebinfo",
      "configurePreset": "vcpkg-x64",
      "configuration": "RelWithDebInfo"
    }
  ]
}